<Project>

  <PropertyGroup>
    <NeutralLanguage>en</NeutralLanguage>
    <ImplicitUsings>enable</ImplicitUsings>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Nullable -->
    <Nullable>enable</Nullable>

    <!-- Packages lock file -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    
    <!-- Versioning -->
    <VerMicrosoft_AspNetCore_OpenApi>11.0.0</VerMicrosoft_AspNetCore_OpenApi>
    <VerMicrosoft_OpenApi>3.11.0</VerMicrosoft_OpenApi>
    <VerMicrosoft_OpenApi_Max>4.0.0</VerMicrosoft_OpenApi_Max>
    <VerMicrosoft_OpenApi_Range>[$(VerMicrosoft_OpenApi),$(VerMicrosoft_OpenApi_Max))</VerMicrosoft_OpenApi_Range>
  </PropertyGroup>

  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v5pm-xwqc-g5wc" />
  </ItemGroup>

</Project>
