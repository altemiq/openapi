<Project>

  <PropertyGroup>
    <NeutralLanguage>en</NeutralLanguage>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Nullable -->
    <Nullable>enable</Nullable>

    <!-- Packages lock file -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    
    <!-- Versioning -->
    <VerMicrosoft_AspNetCore_OpenApi>10.0.11</VerMicrosoft_AspNetCore_OpenApi>
    <VerMicrosoft_OpenApi>2.7.5</VerMicrosoft_OpenApi>
    <VerMicrosoft_OpenApi_Max>3.0.0</VerMicrosoft_OpenApi_Max>
  </PropertyGroup>

  <PropertyGroup Label=".NET Analyzers">
    <AnalysisLevel>preview</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
  </PropertyGroup>

  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v5pm-xwqc-g5wc" />
  </ItemGroup>

</Project>
